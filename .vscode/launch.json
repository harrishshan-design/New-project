{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "RealityGenius: Chrome local static",
      "request": "launch",
      "type": "chrome",
      "url": "http://127.0.0.1:4177",
      "webRoot": "${workspaceFolder}/dist"
    },
    {
      "name": "RealityGenius: Chrome production",
      "request": "launch",
      "type": "chrome",
      "url": "https://realitygenius.company",
      "webRoot": "${workspaceFolder}"
    },
    {
      "name": "RealityGenius: API server",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/server.js",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "node",
      "console": "integratedTerminal"
    },
    {
      "name": "RealityGenius: Playwright debug",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/@playwright/test/cli.js",
      "args": ["test", "--debug"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
